// FILE: .devcontainer/devcontainer.json
// (devcontainer.json allows // comments, so this first line is safe.)
{
  "name": "Legal Metrology Checker",

  // Python 3.11 on Debian "bookworm".
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // Runs once when the Codespace is built:
  //   1) installs two small system libraries that OpenCV needs,
  //   2) installs every Python package from requirements.txt.
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgl1 libglib2.0-0 && pip install -r requirements.txt",

  // Streamlit runs on port 8501.
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit app",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}